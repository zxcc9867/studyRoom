{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm --workspace apps/web run build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/download/android-release\\.json",
      "dest": "/download/android-release.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/download/android\\.apk",
      "status": 307,
      "headers": {
        "Location": "https://github.com/zxcc9867/studyRoom/releases/download/android-v0.2.0-build3/study-room-0.2.0-build3.apk",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/download/android/?",
      "dest": "/download/android.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  }
}
