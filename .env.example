# Shared
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
CRON_SECRET=replace-with-random-secret
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="Study Room <noreply@example.com>"
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_SUBJECT=mailto:you@example.com
SLACK_BOT_TOKEN=replace-with-slack-bot-token
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
APP_ORIGIN=https://your-deployed-web-app.example.com

# Web dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VITE_GOOGLE_AUTH_ENABLED=false

# Expo mobile
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id

# Server-only OpenRouter (leave key/model empty until ready; never use VITE_ or EXPO_PUBLIC_)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_SITE_URL=https://study-room-attendance.vercel.app
OPENROUTER_APP_NAME="Study Room"

# StudyRoom 2.0: Supabase Edge Functions server-only configuration
# Configure these in the runtime; never add VITE_ / EXPO_PUBLIC_ prefixes.
COACH_PILOT_USER_IDS=
COACH_ENCRYPTION_KEY=
SITE_URL=https://study-room-attendance.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
