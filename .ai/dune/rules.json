{
  "schema_version": 2,
  "required_files": [
    "AGENTS.md",
    "CLAUDE.md",
    "memory-bank/design-document.md",
    "memory-bank/active-context.md",
    "memory-bank/implementation-plan.md",
    "memory-bank/progress.md",
    "memory-bank/trouble-shooting.md",
    "memory-bank/prd-user-profile.md",
    "memory-bank/architecture-map.md"
  ],
  "python_import_boundaries": [],
  "javascript_import_boundaries": [
    {
      "id": "feed-ui-server-boundary",
      "sources": ["apps/web/src/TechFeedSection.tsx", "apps/web/src/FeedDailyBriefing.tsx"],
      "forbidden_modules": [],
      "forbidden_paths": ["supabase/functions", "server"],
      "runtime_only": true,
      "use_instead": "Use the authenticated techFeed client. Server-only provider keys, quota reservations and writes belong to the Edge/store modules."
    },
    {
      "id": "team-ui-server-native-boundary",
      "sources": ["apps/web/src/TeamStudySection.tsx", "apps/web/src/PublicTagSettings.tsx", "apps/web/src/teamStudy*.mjs"],
      "forbidden_modules": ["node:fs", "fs", "node:crypto", "crypto"],
      "forbidden_paths": ["supabase/functions", "server", "apps/mobile"],
      "runtime_only": true,
      "use_instead": "Use teamStudyClient guarded authenticated RPCs and existing Dashboard study callbacks. Team persistence and accepted-time aggregation belong to the server; hosted mobile reuses this screen."
    }
  ],
  "verify": [
    "npm.cmd test",
    "npm.cmd run test:edge",
    "npm.cmd run mobile:check",
    "npm.cmd run build",
    "npm.cmd run docs:check"
  ]
}
